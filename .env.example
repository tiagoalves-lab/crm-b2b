# Ambiente: development | staging | production
NODE_ENV=development

# Porta da API — 3001, não 3000: o Next dev server do web/ já usa :3000
# por padrão, e os dois rodam juntos em dev local.
PORT=3001

# Postgres do Supabase — DUAS connection strings distintas, não a mesma:
#
# DATABASE_URL: papel `app_runtime` (ver prisma/migrations/*_app_runtime_role),
# SEM superuser, SEM BYPASSRLS. É a conexão que a aplicação usa em runtime.
# Depois de aplicar a migration desse papel, defina a senha dele fora do
# controle de versão (`ALTER ROLE app_runtime WITH LOGIN PASSWORD '...'`) e
# use essa credencial aqui. RLS não protege nada se essa variável apontar
# pro papel `postgres` — ver docs/seguranca.md.
#
# `connection_limit=1`: cada processo (app rodando, cada suite de teste
# e2e) abre seu próprio PrismaClient — sem isso, o pool interno do Prisma
# (default baseado em número de CPUs) estoura o limite do pooler do
# Supabase em modo sessão (15 conexões) quando vários processos sobem ao
# mesmo tempo (ex.: `npm run test:e2e` com múltiplos workers). Ver
# `feedback_npx_lock_quirk`-style gotcha documentado na memória do projeto.
DATABASE_URL="postgresql://app_runtime:SENHA_AQUI@db.xxxxxxxxxxxx.supabase.co:5432/postgres?schema=public&connection_limit=1"

# DIRECT_URL: connection string privilegiada que o painel do Supabase te dá
# (papel `postgres`) — usada SÓ por `prisma migrate`, nunca pela aplicação.
DIRECT_URL="postgresql://postgres:SENHA_AQUI@db.xxxxxxxxxxxx.supabase.co:5432/postgres?schema=public"

# Auth: Supabase Auth (ver roadmap.md, Fase 0/2). O backend valida o JWT
# emitido pelo Supabase Auth contra o endpoint JWKS público do projeto
# (https://<SUPABASE_URL>/auth/v1/.well-known/jwks.json) — não é segredo,
# é chave pública, mas SUPABASE_URL precisa ser a do projeto real.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Storage de anexos de tarefa (SPEC-CRM-GAMA.md §3.2/§4.3, Fatia 8) — a
# service role key do painel do Supabase (Project Settings > API). NUNCA
# vai pro cliente/web, só o backend usa pra assinar URLs de upload/
# download do bucket privado "task-attachments". Sem esta variável, o
# resto do app funciona normal — só o upload de anexo devolve erro claro.
# Opcional (não trava o boot da aplicação se ausente).
SUPABASE_SERVICE_ROLE_KEY="SERVICE_ROLE_KEY_AQUI"

# Origem exata do frontend (web/) para CORS restritivo — nunca "*" com
# credenciais habilitadas (ver docs/seguranca.md, seção 5). Em dev, o
# backend usa http://localhost:3000 por padrão se esta variável não for
# definida; em produção é obrigatório configurar.
FRONTEND_ORIGIN="http://localhost:3000"

# Integração eGestor (importação de clientes/vendas, ver
# docs/api-egestor-contatos.md e docs/api-egestor-vendas.md) — Bearer
# token de cada uma das duas contas eGestor da Gama (Matriz e Filial são
# contas separadas no eGestor, cada uma com seu próprio token). Só o
# backend usa, nunca web/. Opcional: sem elas, só o módulo de sync com o
# eGestor não funciona, o resto do app roda normal.
EGESTOR_API_TOKEN_MATRIZ="TOKEN_AQUI"
EGESTOR_API_TOKEN_FILIAL="TOKEN_AQUI"

# Webhook eGestor (push de contatos, ver docs/webhook-egestor.md) — o
# securityToken é o valor que o eGestor devolve no cadastro (POST
# /webhooks) de cada conta, usado pra autenticar o payload recebido em
# POST /integrations/egestor/webhook/:estabelecimento. Só o backend usa,
# nunca web/. Matriz e Filial configuradas em produção (2026-08-12).
EGESTOR_WEBHOOK_SECURITY_TOKEN_MATRIZ="TOKEN_AQUI"
EGESTOR_WEBHOOK_SECURITY_TOKEN_FILIAL="TOKEN_AQUI"

# Central de Leads do Meta (Lead Ads Facebook/Instagram do Portfólio da
# Gama, ver docs/webhook-meta-leads.md) — App próprio no Meta for
# Developers. Só o backend usa, nunca web/. Opcional: sem elas, só a
# ingestão de leads do Meta não funciona, o resto do app roda normal.
#
# META_APP_SECRET: App Secret do App (Meta for Developers → Configurações
# → Básico), usado pra conferir a assinatura HMAC X-Hub-Signature-256 de
# todo evento recebido em POST /integrations/meta-leads/webhook.
META_APP_SECRET="APP_SECRET_AQUI"
# META_PAGE_ACCESS_TOKEN: token de acesso da Página vinculada ao App —
# o webhook manda só o leadgen_id, os campos do lead vêm de um GET
# /{leadgen_id} autenticado com este token.
META_PAGE_ACCESS_TOKEN="PAGE_ACCESS_TOKEN_AQUI"
# META_VERIFY_TOKEN: valor arbitrário escolhido por nós no cadastro da
# assinatura do webhook — a Meta devolve no handshake (GET) e o CRM
# confirma antes de aceitar a URL.
META_VERIFY_TOKEN="VERIFY_TOKEN_AQUI"
# META_LEADS_DEFAULT_OWNER_USER_ID: Membership.userId (UUID de auth.users,
# copiar de /dashboard/membros) do gerente que vira dono de todo lead
# capturado pela Central de Leads — decisão do usuário, 2026-08-14 (ver
# docs/roadmap.md, decisão 1.2). Sem isto configurado o webhook responde
# 200 e registra o evento, mas não cria RawLead (fica pra reprocessar).
META_LEADS_DEFAULT_OWNER_USER_ID="UUID_AQUI"

# Integração com o app de cotações (gama-webapp, ver
# docs/integracao-cotacoes.md) — token estático conferido nas rotas públicas
# /integrations/cotacoes/* (Authorization: Bearer). Gerado pelo GAS
# (crm_config_instalar no editor do Apps Script, fica nas Script Properties
# de lá) e copiado pra cá. Só o backend usa, nunca web/. Opcional: sem ela,
# essas rotas respondem 401 e o resto do app roda normal.
COTACOES_API_TOKEN="TOKEN_AQUI"
