# Ambiente: development | staging | production
NODE_ENV=development

# Porta da API
PORT=3000

# Postgres — usado tanto pela app quanto pelo Prisma Migrate
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_b2b_dev?schema=public"

# Auth própria (JWT) — segredos distintos por ambiente, nunca reaproveitar
JWT_SECRET="change-me-in-every-environment"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-every-environment"
JWT_REFRESH_EXPIRES_IN="7d"
