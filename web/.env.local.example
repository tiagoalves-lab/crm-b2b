# Copie para .env.local (não versionado) e preencha com os valores reais
# do seu projeto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"

# URL do backend NestJS (repo raiz, roda em :3001 em dev — ver .env.example
# da raiz). Não é segredo (é só a URL da API, chamada direto do navegador
# também), mas o URL real de produção varia por ambiente.
NEXT_PUBLIC_API_URL="http://localhost:3001"
